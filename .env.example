# CampusFlow - Supabase Configuration
# To connect to your Supabase project:
# 1. Create a project at https://supabase.com
# 2. Run the SQL script in supabase/schema.sql in the SQL Editor
# 3. Copy your Project URL and Publishable / Anon Key from Project Settings -> API
# 4. Fill them in here. If left blank, CampusFlow runs in rich interactive LocalStorage Demo Mode.

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

